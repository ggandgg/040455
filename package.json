{
  "name": "photo-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:privacy": "node scripts/check-no-network-deps.mjs",
    "check:all": "npm run typecheck && npm run lint && npm run check:privacy",
    "prebuild": "expo prebuild --platform ios --clean",
    "build:dev": "eas build --platform ios --profile development",
    "build:preview": "eas build --platform ios --profile preview",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "expo": "~55.0.24",
    "expo-constants": "~55.0.16",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "~55.0.20",
    "expo-haptics": "~55.0.7",
    "expo-image": "~55.0.10",
    "expo-image-picker": "~55.0.20",
    "expo-linking": "~55.0.10",
    "expo-media-library": "~55.0.17",
    "expo-router": "~55.0.14",
    "expo-sharing": "~55.0.10",
    "expo-splash-screen": "~55.0.13",
    "expo-sqlite": "~55.0.16",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.7",
    "expo-video": "~55.0.17",
    "movie-maker": "file:./modules/movie-maker",
    "react": "19.2.6",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-reanimated": "~4.3.1",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.25.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.1.3",
    "@types/react": "~19.1.1",
    "eslint": "^9.15.0",
    "eslint-config-expo": "~9.0.0",
    "patch-package": "^8.0.1",
    "typescript": "~5.6.0"
  }
}
